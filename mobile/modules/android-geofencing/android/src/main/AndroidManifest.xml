<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Legacy Activity Recognition (pre-Android 10) -->
  <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
  <!-- Runtime Activity Recognition (Android 10+) -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <!-- Restore geofences after reboot (Android clears all registered geofences on every restart) -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <receiver
      android:name="expo.modules.androidgeofencing.GeofenceBroadcastReceiver"
      android:enabled="true"
      android:exported="false" />
    <receiver
      android:name="expo.modules.androidgeofencing.ActivityTransitionReceiver"
      android:enabled="true"
      android:exported="false" />
    <receiver
      android:name="expo.modules.androidgeofencing.BootCompletedReceiver"
      android:enabled="true"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
